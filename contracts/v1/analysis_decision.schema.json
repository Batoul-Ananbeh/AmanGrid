{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://amangrid.local/contracts/v1/analysis_decision.schema.json",
  "title": "AnalysisDecision",
  "description": "DRAFT explainable analysis and decision-guidance output contract.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "analysis_id",
    "document_id",
    "classification",
    "sensitive_findings",
    "energy_context",
    "evidence",
    "risk",
    "policy"
  ],
  "properties": {
    "contract_version": {
      "const": "1.0"
    },
    "analysis_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "document_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "classification": {
      "$ref": "#/$defs/classification"
    },
    "sensitive_findings": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "$ref": "#/$defs/sensitiveFinding"
      }
    },
    "energy_context": {
      "$ref": "#/$defs/energyContext"
    },
    "evidence": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "$ref": "#/$defs/evidenceItem"
      }
    },
    "risk": {
      "$ref": "#/$defs/risk"
    },
    "policy": {
      "$ref": "#/$defs/policy"
    }
  },
  "$defs": {
    "classification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["level", "confidence", "explanation"],
      "properties": {
        "level": {
          "enum": ["Public", "Internal", "Confidential", "Restricted"]
        },
        "confidence": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "explanation": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        }
      }
    },
    "sensitiveFinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "count"],
      "properties": {
        "type": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[A-Z][A-Z0-9_]*$"
        },
        "count": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "energyContext": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scada_ot_relevant", "summary"],
      "properties": {
        "scada_ot_relevant": {
          "type": "boolean"
        },
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        }
      }
    },
    "evidenceItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "excerpt", "masked"],
      "properties": {
        "type": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[A-Z][A-Z0-9_]*$"
        },
        "excerpt": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "masked": {
          "const": true
        }
      }
    },
    "riskFactor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["factor_id", "label", "severity", "explanation"],
      "properties": {
        "factor_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "severity": {
          "enum": ["none", "low", "medium", "high", "critical", "unknown"]
        },
        "explanation": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        }
      }
    },
    "risk": {
      "type": "object",
      "additionalProperties": false,
      "required": ["base_score", "final_score", "level", "factors", "triggered_overrides"],
      "properties": {
        "base_score": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "final_score": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "level": {
          "enum": ["Low", "Medium", "High", "Critical"]
        },
        "factors": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "items": {
            "$ref": "#/$defs/riskFactor"
          }
        },
        "triggered_overrides": {
          "type": "array",
          "maxItems": 20,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[A-Z][A-Z0-9_-]*$"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "final_score": {"minimum": 0, "maximum": 24}
            },
            "required": ["final_score"]
          },
          "then": {
            "properties": {
              "level": {"const": "Low"}
            }
          }
        },
        {
          "if": {
            "properties": {
              "final_score": {"minimum": 25, "maximum": 49}
            },
            "required": ["final_score"]
          },
          "then": {
            "properties": {
              "level": {"const": "Medium"}
            }
          }
        },
        {
          "if": {
            "properties": {
              "final_score": {"minimum": 50, "maximum": 74}
            },
            "required": ["final_score"]
          },
          "then": {
            "properties": {
              "level": {"const": "High"}
            }
          }
        },
        {
          "if": {
            "properties": {
              "final_score": {"minimum": 75, "maximum": 100}
            },
            "required": ["final_score"]
          },
          "then": {
            "properties": {
              "level": {"const": "Critical"}
            }
          }
        }
      ]
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "recommendations",
        "human_review_required",
        "review_reasons",
        "triggered_rule_ids"
      ],
      "properties": {
        "recommendations": {
          "type": "array",
          "minItems": 1,
          "maxItems": 10,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/recommendation"
          },
          "contains": {
            "properties": {"is_primary": {"const": true}},
            "required": ["is_primary"]
          },
          "minContains": 1,
          "maxContains": 1
        },
        "human_review_required": {
          "type": "boolean"
        },
        "review_reasons": {
          "type": "array",
          "maxItems": 20,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          }
        },
        "triggered_rule_ids": {
          "type": "array",
          "maxItems": 20,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[A-Z][A-Z0-9_-]*$"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "human_review_required": {"const": true}
            },
            "required": ["human_review_required"]
          },
          "then": {
            "properties": {
              "review_reasons": {"minItems": 1},
              "recommendations": {
                "contains": {
                  "properties": {"action": {"const": "HUMAN_REVIEW"}},
                  "required": ["action"]
                },
                "minContains": 1,
                "maxContains": 1
              }
            }
          },
          "else": {
            "properties": {
              "review_reasons": {"maxItems": 0},
              "recommendations": {
                "not": {
                  "contains": {
                    "properties": {"action": {"const": "HUMAN_REVIEW"}},
                    "required": ["action"]
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "recommendations": {
                "contains": {
                  "properties": {"action": {"const": "ALLOW"}},
                  "required": ["action"]
                },
                "minContains": 1
              }
            },
            "required": ["recommendations"]
          },
          "then": {
            "properties": {
              "recommendations": {
                "items": {
                  "properties": {
                    "action": {"enum": ["ALLOW", "LOG"]}
                  }
                }
              }
            }
          }
        }
      ]
    },
    "recommendation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action", "execution_mode", "is_primary", "reason"],
      "properties": {
        "action": {
          "enum": [
            "ALLOW",
            "LOG",
            "WARN",
            "REQUIRE_JUSTIFICATION",
            "RESTRICT_ACCESS",
            "BLOCK",
            "ENCRYPT",
            "QUARANTINE",
            "ALERT",
            "HUMAN_REVIEW"
          ]
        },
        "execution_mode": {
          "enum": ["RECOMMENDED", "SIMULATED"]
        },
        "is_primary": {
          "type": "boolean"
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "risk": {
            "properties": {
              "level": {"const": "Critical"}
            },
            "required": ["level"]
          }
        },
        "required": ["risk"]
      },
      "then": {
        "properties": {
          "policy": {
            "properties": {
              "human_review_required": {"const": true}
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "classification": {
            "properties": {
              "confidence": {"maximum": 69}
            },
            "required": ["confidence"]
          }
        },
        "required": ["classification"]
      },
      "then": {
        "properties": {
          "policy": {
            "properties": {
              "human_review_required": {"const": true}
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "risk": {
            "properties": {
              "triggered_overrides": {"minItems": 1}
            },
            "required": ["triggered_overrides"]
          }
        },
        "required": ["risk"]
      },
      "then": {
        "properties": {
          "policy": {
            "properties": {
              "human_review_required": {"const": true}
            }
          }
        }
      }
    }
  ]
}
